# Postgres — required for both local dev and Netlify production.
# A free project on https://neon.tech or https://supabase.com works well.
#
# DATABASE_URL: the POOLED connection string (used by the running app —
#   serverless functions open a lot of short-lived connections, and a
#   pooler keeps that from exhausting your database's connection limit).
#   On Neon this is the "-pooler" hostname; on Supabase it's the port-6543
#   "Transaction" mode string. Append "?pgbouncer=true&connection_limit=1"
#   to the end of it — Prisma needs that flag to behave correctly through
#   a PgBouncer-style pooler, which is exactly what serverless functions
#   need since each invocation can open its own connection.
# DIRECT_URL: the DIRECT (non-pooled) connection string — Prisma needs
#   this specifically to run migrations, which don't work through a
#   transaction-mode pooler. No extra query params needed on this one.
DATABASE_URL=""
DIRECT_URL=""

# FRED (Federal Reserve Economic Data) — required for economic indicators.
# Free, instant signup: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=""

# No key required for these (verify current terms before heavy use):
#   ECB Data Portal (SDW)        https://data.ecb.europa.eu/help/api/overview
#   exchangerate.host            https://exchangerate.host
#   CoinGecko public API         https://www.coingecko.com/en/api
